@startuml ui-component-hierarchy
!theme plain
skinparam backgroundColor #FEFEFE
skinparam defaultFontSize 12

title UI 组件层次结构

legend right
  |= 模块 |= 颜色 |= 说明 |
  | :ime-ui | <#E8F5E9> | UI + ViewModel Layer |
  | :ime-engine | <#FFF3E0> | Domain Layer (依赖) |
endlegend

' ===== ViewModel 层 =====
package "ViewModel 层 [:ime-ui]" #E8F5E9 {
  class KeyboardViewModel <<ViewModel>> {
    + state: StateFlow<ImeState>
    + config: ImeConfig
    + layoutMode: StateFlow<LayoutMode>
    + feedbackState: GestureFeedbackState
    + actionPlayer: InputActionPlayer
    + handleGesture(gesture)
    + handleIntent(intent)
    + setLayoutMode(mode)
    + updateConfig(transform)
  }
  class GestureFeedbackState {
    + touchTrailPoints: StateFlow<List<OffsetF>>
    + pressedKeys: StateFlow<Set<InputKey>>
    + fingerIndicator: StateFlow<InputActionFingerIndicator?>
  }
  KeyboardViewModel *-- GestureFeedbackState
}

' ===== 集成组件 =====
package "集成组件 [:ime-ui]" #E8F5E9 {
  class KeyboardHost <<集成>> {
    统一 Stacked/Separated 布局
    订阅 viewModel.state / layoutMode / feedbackState
  }
  class KeyboardInputActionPlayerHost <<集成>> {
    UseMode.Animation (演示)
    UseMode.DirectInput (输入辅助)
    组合 KeyboardHost + 播放引擎
    showIndicator 控制
  }
  KeyboardInputActionPlayerHost *-- KeyboardHost
  KeyboardHost --> KeyboardViewModel : viewModel
  KeyboardInputActionPlayerHost --> KeyboardViewModel : viewModel
}

' ===== 面板组件 =====
package "面板组件 [:ime-ui]" #E8F5E9 {

  package "三层面板 (Row 3 / Zone A)" {
    class GestureInputPanel <<面板>> {
      透明手势拦截层 (最上层)
      接收触摸事件
      识别手势类型
      输出 InputGesture
    }
    class KeyLayoutPanel <<面板>> {
      按键布局渲染层 (最下层)
      根据 InputMode + Type 渲染
      onLayoutStateChanged 回调
    }
    class GestureFeedbackPanel <<面板>> {
      透明反馈绘制层 (中间层)
      归一化坐标绘制
      支持多实例 (Zone A + Zone B)
    }
  }

  package "信息面板 (Row 1)" {
    class CandidateListPanel <<面板>> {
      候选栏
      含内建 IndicatorOverlay
      showIndicator + indicatorState
    }
    class PopupTipPanel <<面板>> {
      弹出提示面板
      从 ImeState.popupTip 读取
      叠加在 CandidateListPanel 上方
    }
  }

  package "交互面板 (Row 2)" {
    class InputListPanel <<面板>> {
      输入栏 (输入时显示)
      含内建 IndicatorOverlay
      互斥于 ToolListPanel
    }
    class ToolListPanel <<面板>> {
      工具列表面板 (空闲时显示)
      含内建 IndicatorOverlay
      含编辑功能键
    }
  }
}

' ===== 原子组件 =====
package "原子组件 [:ime-ui]" #E8F5E9 {
  class KeyView <<原子>> {
    单个按键渲染
  }
  class CandidateItem <<原子>> {
    单个候选项
  }
  class CharInputItem <<原子>> {
    输入栏字符项
  }
  class GapInputItem <<原子>> {
    输入栏间隙项
  }
  class PopupTipItem <<原子>> {
    弹出提示内容项
  }
  class ToolItem <<原子>> {
    工具按钮项
  }

  KeyLayoutPanel *-- KeyView
  CandidateListPanel *-- CandidateItem
  InputListPanel *-- CharInputItem
  InputListPanel *-- GapInputItem
  PopupTipPanel *-- PopupTipItem
  ToolListPanel *-- ToolItem
}

' ===== 主题系统 =====
package "主题系统 [:ime-ui]" #E8F5E9 {
  class KeyboardTheme <<主题>> {
    支持跟随系统
    Light / Night 预置
  }
  class KeyboardColors <<主题>> {
    键盘/候选/输入栏/X-Pad 颜色
  }
  class KeyboardThemes <<主题>> {
    Light / Night 预置
  }
  class LocalKeyboardColors <<主题>> {
    CompositionLocal 提供颜色
  }
}

' ===== 工具组件 =====
package "工具组件 [:ime-ui]" #E8F5E9 {
  class CoordinateNormalizer <<工具>> {
    + normalize(offset, sourceSize): OffsetF
    + denormalize(normalized, targetSize): Offset
  }
  class ComposeInputActionPositionResolver <<工具>> {
    实现 InputActionPositionResolver
    从 KeyLayoutState 读取归一化坐标
  }
  class InputActionScriptLoader <<工具>> {
    + loadPreset(name): InputActionScript
    + listPresets(): List<String>
    + loadFromFile(uri): InputActionScript
  }
}

' ===== 播放器组件 =====
package "播放器组件 [:ime-ui]" #E8F5E9 {
  class InputActionPlayer <<播放器>> {
    + playbackState
    + row1IndicatorState
    + row2IndicatorState
    + load / play / pause / stop
  }
}

' ===== 引擎依赖 =====
package "引擎依赖 [:ime-engine]" #FFF3E0 {
  interface InputActionPositionResolver <<接口>> {
    + resolve(key): OffsetF?
    + resolveCandidatePosition(index): OffsetF?
    + resolveInputItemPosition(index): OffsetF?
  }
  class InputActionFingerIndicator {
    + position: OffsetF
    + pressed: Boolean
    + clickAnimation: ClickAnimation?
  }
}

ComposeInputActionPositionResolver -up-|> InputActionPositionResolver

@enduml
