@startuml ui-component-hierarchy
!theme plain
skinparam backgroundColor #FEFEFE
skinparam defaultFontSize 12

title UI Component Hierarchy

legend right
  |= Module |= Color |= Description |
  | :ui | <#E8F5E9> | UI + ViewModel Layer |
  | :engine | <#FFF3E0> | Domain Layer (dependency) |
endlegend

' ===== ViewModel Layer =====
package "ViewModel Layer [:ui]" #E8F5E9 {
  class KeyboardViewModel <<ViewModel>> {
    + state: StateFlow<ImeState>
    + config: ImeConfig
    + layoutMode: StateFlow<KeyboardLayoutMode>
    + feedbackState: GestureFeedbackState
    + actionPlayer: InputActionPlayer
    + handleGesture(gesture)
    + handleIntent(intent)
    + setKeyboardLayoutMode(mode)
    + updateConfig(transform)
  }
  class GestureFeedbackState {
    + touchTrailPoints: StateFlow<List<OffsetF>>
    + pressedKeys: StateFlow<Set<InputKey>>
    + fingerIndicator: StateFlow<InputActionFingerIndicator?>
  }
  KeyboardViewModel *-- GestureFeedbackState
}

' ===== Integration Components =====
package "Integration Components [:ui]" #E8F5E9 {
  class KeyboardHost <<Integration>> {
    Unified Stacked/Separated layout
    Subscribes viewModel.state / layoutMode / feedbackState
  }
  class KeyboardInputActionPlayerHost <<Integration>> {
    UseMode.Animation (demo)
    UseMode.DirectInput (input assistance)
    Composes KeyboardHost + playback engine
    showIndicator control
  }
  KeyboardInputActionPlayerHost *-- KeyboardHost
  KeyboardHost --> KeyboardViewModel : viewModel
  KeyboardInputActionPlayerHost --> KeyboardViewModel : viewModel
}

' ===== Panel Components =====
package "Panel Components [:ui]" #E8F5E9 {

  package "Three-Layer Panels (Row 3 / Zone A)" {
    class GestureInputPanel <<Panel>> {
      Transparent gesture interception layer (topmost)
      Receives touch events
      Recognizes gesture types
      Outputs InputGesture
    }
    class KeyLayoutPanel <<Panel>> {
      Key layout rendering layer (bottommost)
      Renders based on KeyboardInputMode + Type
      onLayoutStateChanged callback
    }
    class GestureFeedbackPanel <<Panel>> {
      Transparent feedback drawing layer (middle)
      Normalized coordinate drawing
      Supports multi-instance (Zone A + Zone B)
    }
  }

  package "Info Panels (Row 1)" {
    class CandidateListPanel <<Panel>> {
      Candidate bar
      Built-in IndicatorOverlay
      showIndicator + indicatorState
    }
    class PopupTipPanel <<Panel>> {
      Popup tip panel
      Reads from viewModel.popupTipState
      Overlays above CandidateListPanel
    }
  }

  package "Interaction Panels (Row 2)" {
    class InputListPanel <<Panel>> {
      Input bar (visible during input)
      Built-in IndicatorOverlay
      Mutually exclusive with ToolListPanel
    }
    class ToolListPanel <<Panel>> {
      Tool list panel (visible when idle)
      Built-in IndicatorOverlay
      Includes editing function keys
    }
  }
}

' ===== Atomic Components =====
package "Atomic Components [:ui]" #E8F5E9 {
  class KeyView <<Atomic>> {
    Single key rendering
  }
  class CandidateItem <<Atomic>> {
    Single candidate item
  }
  class CharInputItem <<Atomic>> {
    Input bar character item
  }
  class GapInputItem <<Atomic>> {
    Input bar gap item
  }
  class PopupTipItem <<Atomic>> {
    Popup tip content item
  }
  class ToolItem <<Atomic>> {
    Tool button item
  }

  KeyLayoutPanel *-- KeyView
  CandidateListPanel *-- CandidateItem
  InputListPanel *-- CharInputItem
  InputListPanel *-- GapInputItem
  PopupTipPanel *-- PopupTipItem
  ToolListPanel *-- ToolItem
}

' ===== Theme System =====
package "Theme System [:ui]" #E8F5E9 {
  class KeyboardTheme <<Theme>> {
    Follows system
    Light / Night presets
  }
  class KeyboardColors <<Theme>> {
    Keyboard/candidate/input bar colors
  }
  class KeyboardThemes <<Theme>> {
    Light / Night presets
  }
  class LocalKeyboardColors <<Theme>> {
    CompositionLocal providing colors
  }
}

' ===== Utility Components =====
package "Utility Components [:ui]" #E8F5E9 {
  class CoordinateNormalizer <<Utility>> {
    + normalize(offset, sourceSize): OffsetF
    + denormalize(normalized, targetSize): Offset
  }
  class ComposeInputActionPositionResolver <<Utility>> {
    Implements InputActionPositionResolver
    Reads normalized coords from KeyLayoutState
  }
  class InputActionScriptLoader <<Utility>> {
    + loadPreset(name): InputActionScript
    + listPresets(): List<String>
    + loadFromFile(uri): InputActionScript
  }
}

' ===== Player Components =====
package "Player Components [:ui]" #E8F5E9 {
  class InputActionPlayer <<Player>> {
    + playbackState
    + row1IndicatorState
    + row2IndicatorState
    + load / play / pause / stop
  }
}

' ===== Engine Dependencies =====
package "Engine Dependencies [:engine]" #FFF3E0 {
  interface InputActionPositionResolver <<Interface>> {
    + resolve(key): OffsetF?
    + resolveCandidatePosition(index): OffsetF?
    + resolveInputItemPosition(index): OffsetF?
  }
  class InputActionFingerIndicator {
    + position: OffsetF
    + pressed: Boolean
    + clickAnimation: ClickAnimation?
  }
}

ComposeInputActionPositionResolver -up-|> InputActionPositionResolver

@enduml
