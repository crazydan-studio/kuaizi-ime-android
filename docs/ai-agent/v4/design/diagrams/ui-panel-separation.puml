@startuml ui-panel-separation
!theme plain
skinparam backgroundColor #FEFEFE
skinparam defaultFontSize 12

title 面板三层分离与屏幕布局

legend right
  |= 颜色 |= 说明 |
  ##C8E6C9 | GestureInputPanel (最上层)
  ##FFF9C4 | GestureFeedbackPanel (中间层)
  ##BBDEFB | KeyLayoutPanel (最下层)
  ##FFCDD2 | 信息面板 (Row 1/2)
  ##E1BEE7 | 指示器/覆盖层
endlegend

' ===== 三层分离核心 =====
rectangle "三层分离架构" as ThreeLayer #FFFFFF {
  rectangle "最上层: GestureInputPanel\n(透明手势层)" as GIP #C8E6C9 {
    note right
      接收原始触摸事件
      识别手势类型 (点击/长按/滑行/翻转)
      查询 KeyLayoutState 定位按键
      输出 InputGesture → ViewModel
      驱动 GestureFeedbackState → 反馈面板
      不绘制任何视觉反馈 (完全透明)
    end note
  }
  rectangle "中间层: GestureFeedbackPanel\n(透明绘制层，可多实例)" as GFP #FFF9C4 {
    note right
      绘制输入轨迹 (含按键间路径/X-Pad路径)
      绘制按键高亮
      绘制手指指示器 (程序化输入)
      绘制 clickAnimation 涟漪
      不处理触摸事件
      使用归一化坐标绘制
    end note
  }
  rectangle "最下层: KeyLayoutPanel\n(按键布局层，单实例)" as KLP #BBDEFB {
    note right
      根据 InputMode + Type 渲染按键
      展示按键状态 (按下/激活/禁用)
      提供 KeyLayoutState 供查询
      onLayoutStateChanged 回调
      不处理触摸事件
    end note
  }
}

' ===== 通信解耦 =====
rectangle "InputGesture\n(坐标无关)" as IG
rectangle "GestureFeedbackState\n(归一化坐标)" as GFS
rectangle "ImeState\n(不可变状态)" as IS

GIP -down-> IG : 输出
IG -down-> KLP : ViewModel → ImeState
GIP -down-> GFS : 驱动
GFS -down-> GFP : 消费
IS -down-> KLP : 驱动

' ===== Zone A / Zone B =====
rectangle "屏幕分区" as Zones #FFFFFF {

  rectangle "Zone A (上半区)\n仅 Separated 模式使用" as ZoneA #F5F5F5 {
    rectangle "KeyLayoutPanel\n(底层渲染)" as ZA_KLP #BBDEFB
    rectangle "GestureFeedbackPanel\n(Zone A 实例)\n透明反馈层" as ZA_GFP #FFF9C4
    ZA_KLP -[hidden]up- ZA_GFP
  }

  rectangle "Zone B (下半区)\n两种模式均使用" as ZoneB #F5F5F5 {

    rectangle "Row 1: 候选提示区\n叠加共存" as Row1 #FFCDD2 {
      rectangle "CandidateListPanel\n(含内建 IndicatorOverlay)" as R1_CLP #FFCDD2
      rectangle "PopupTipPanel\n(叠加，短暂浮现)" as R1_PTP #E1BEE7
    }

    rectangle "Row 2: 工具/输入区\n互斥共存" as Row2 #FFCDD2 {
      rectangle "ToolListPanel\n(空闲时显示)\n含内建 IndicatorOverlay" as R2_TLP #FFCDD2
      rectangle "InputListPanel\n(输入时互斥显示)\n含内建 IndicatorOverlay" as R2_ILP #FFCDD2
      R2_TLP .> R2_ILP : 互斥
    }

    rectangle "Row 3: 键盘交互区\n三层叠加共存" as Row3 #FFFFFF {
      rectangle "KeyLayoutPanel\n(最下层，渲染)" as R3_KLP #BBDEFB
      rectangle "GestureFeedbackPanel\n(Zone B 实例，反馈)" as R3_GFP #FFF9C4
      rectangle "GestureInputPanel\n(最上层，触摸)" as R3_GIP #C8E6C9
    }
  }
}

' ===== 数据模型 =====
package "数据模型" {
  rectangle "InputGesture\n(坐标无关)" as IG2 {
    note right
      Tap, LongPress, Swipe
      Flip, XPadZonePath
      CandidateTap
    end note
  }
  rectangle "GestureFeedbackState\n(归一化坐标)" as GFS2 {
    note right
      touchTrailPoints: List<OffsetF>
      pressedKeys: Set<InputKey>
      fingerIndicator: InputActionFingerIndicator?
    end note
  }
  rectangle "InputActionFingerIndicator\n(归一化坐标)" as IAFI {
    note right
      position: OffsetF
      pressed: Boolean
      visible: Boolean
      clickAnimation: ClickAnimation?
      手指指示器（绘制手指图形 + 点击动画）
    end note
  }
  rectangle "KeyLayoutState\n(归一化坐标)" as KLS {
    note right
      keyPositions: Map<InputKey, RectF>
      findKeyAt(position): InputKey?
      onLayoutStateChanged 回调
    end note
  }
  rectangle "CoordinateNormalizer" as CN {
    note right
      normalize(offset, size): OffsetF
      denormalize(OffsetF, size): Offset
    end note
  }
}

@enduml
