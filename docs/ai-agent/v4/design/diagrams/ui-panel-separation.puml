@startuml ui-panel-separation
allowmixing
!theme plain
skinparam backgroundColor #FEFEFE
skinparam defaultFontSize 12

title Panel Three-Layer Separation & Screen Layout

legend right
  |= Color |= Description |
  | <#C8E6C9> | GestureInputPanel (topmost) |
  | <#FFF9C4> | GestureFeedbackPanel (middle) |
  | <#BBDEFB> | KeyLayoutPanel (bottommost) |
  | <#FFCDD2> | Info panels (Row 1/2) |
  | <#E1BEE7> | Indicator/overlay |
  | <#F5F5F5> | Zone container |
  | <#FFFFFF> | Neutral container |
endlegend

' ===== Three-Layer Separation Core =====
rectangle "Three-Layer Separation Architecture" as ThreeLayer #FFFFFF {
  rectangle "Top: GestureInputPanel\n(Transparent Gesture Layer)" as GIP #C8E6C9
  rectangle "Middle: GestureFeedbackPanel\n(Transparent Drawing Layer, Multi-Instance)" as GFP #FFF9C4
  rectangle "Bottom: KeyLayoutPanel\n(Key Layout Layer, Single Instance)" as KLP #BBDEFB
}

note right of GIP
  Receives raw touch events
  Recognizes gesture types (tap/long-press/slide/flip)
  Queries KeyLayoutState for key targeting
  Outputs InputGesture → ViewModel
  Drives GestureFeedbackState → feedback panel
  Does not draw any visual feedback (fully transparent)
end note

note right of GFP
  Draws input trail (including inter-key paths)
  Draws key highlights
  Draws finger indicator (programmatic input)
  Draws clickAnimation ripple
  Does not handle touch events
  Uses normalized coordinates for drawing
end note

note right of KLP
  Renders keys based on KeyboardInputMode + Type
  Shows key state (pressed/active/disabled)
  Provides KeyLayoutState for queries
  onLayoutStateChanged callback
  Does not handle touch events
end note

' ===== Communication Decoupling =====
rectangle "InputGesture\n(Coordinate-Independent)" as IG
rectangle "GestureFeedbackState\n(Normalized Coordinates)" as GFS
rectangle "ImeState\n(Immutable State)" as IS

GIP -down-> IG : outputs
IG -down-> KLP : ViewModel → ImeState
GIP -down-> GFS : drives
GFS -down-> GFP : consumes
IS -down-> KLP : drives

' ===== Zone A / Zone B =====
rectangle "Screen Zones" as Zones #FFFFFF {

  rectangle "Zone A (Upper Half)\nSeparated Mode Only" as ZoneA #F5F5F5 {
    rectangle "KeyLayoutPanel\n(Bottom Rendering)" as ZA_KLP #BBDEFB
    rectangle "GestureFeedbackPanel\n(Zone A Instance)\nTransparent Feedback Layer" as ZA_GFP #FFF9C4
    ZA_KLP -[hidden]up- ZA_GFP
  }

  rectangle "Zone B (Lower Half)\nBoth Modes Use" as ZoneB #F5F5F5 {

    rectangle "Row 1: Candidate & Hint Area\nOverlay Coexistence" as Row1 #FFCDD2 {
      rectangle "CandidateListPanel\n(Built-in IndicatorOverlay)" as R1_CLP #FFCDD2
      rectangle "PopupTipPanel\n(Overlay, Transient)" as R1_PTP #E1BEE7
    }

    rectangle "Row 2: Tool & Input Area\nMutually Exclusive" as Row2 #FFCDD2 {
      rectangle "ToolListPanel\n(Shown When Idle)\nBuilt-in IndicatorOverlay" as R2_TLP #FFCDD2
      rectangle "InputListPanel\n(Mutually Exclusive When Inputting)\nBuilt-in IndicatorOverlay" as R2_ILP #FFCDD2
      R2_TLP .> R2_ILP : mutually exclusive
    }

    rectangle "Row 3: Keyboard Interaction Area\nThree-Layer Overlay Coexistence" as Row3 #FFFFFF {
      rectangle "KeyLayoutPanel\n(Bottommost, Rendering)" as R3_KLP #BBDEFB
      rectangle "GestureFeedbackPanel\n(Zone B Instance, Feedback)" as R3_GFP #FFF9C4
      rectangle "GestureInputPanel\n(Topmost, Touch)" as R3_GIP #C8E6C9
    }
  }
}

' ===== Data Models =====
package "Data Models" {
  rectangle "InputGesture\n(Coordinate-Independent)" as IG2
  rectangle "GestureFeedbackState\n(Normalized Coordinates)" as GFS2
  rectangle "InputActionFingerIndicator\n(Normalized Coordinates)" as IAFI
  rectangle "KeyLayoutState\n(Normalized Coordinates)" as KLS
  rectangle "CoordinateNormalizer" as CN
}

note right of IG2
  Tap, LongPress, Swipe
  Flip, CandidateTap
end note

note right of GFS2
  touchTrailPoints: List<OffsetF>
  pressedKeys: Set<InputKey>
  fingerIndicator: InputActionFingerIndicator?
end note

note right of IAFI
  position: OffsetF
  pressed: Boolean
  visible: Boolean
  clickAnimation: ClickAnimation?
  Finger indicator (draws finger graphic + click animation)
end note

note right of KLS
  keyPositions: Map<InputKey, RectF>
  findKeyAt(position): InputKey?
  onLayoutStateChanged callback
end note

note right of CN
  normalize(offset, size): OffsetF
  denormalize(OffsetF, size): Offset
end note

@enduml
