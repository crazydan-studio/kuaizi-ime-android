@startuml mvi-data-flow
!theme plain
skinparam backgroundColor #FEFEFE
skinparam defaultFontSize 12
skinparam arrowThickness 1.5

title MVI 完整数据流

legend right
  |= 模块 |= 颜色 |= 说明 |
  | :app | ##E3F2FD | Platform Layer |
  | :ime-ui | ##E8F5E9 | UI + ViewModel Layer |
  | :ime-engine | ##FFF3E0 | Domain + Data Layer |
endlegend

' ===== 用户手势输入流（主流程） =====

rectangle "用户" as User #FFFFFF {
}

package "UI Layer [:ime-ui]" #E8F5E9 {
  rectangle "GestureInputPanel\n(透明手势层)" as GIP #C8E6C9 {
    note right of GIP
      接收触摸事件
      归一化坐标写入 GestureFeedbackState
      查询 KeyLayoutState.findKeyAt()
      输出 InputGesture
    end note
  }

  rectangle "KeyboardViewModel\n(UI 协调中心)" as KVM #C8E6C9 {
    note right of KVM
      gestureToIntent() 转换
      handleGesture() / handleIntent()
      管理 LayoutMode
      管理 GestureFeedbackState
      集成 InputActionPlayer
    end note
  }

  rectangle "GestureFeedbackState\n(归一化坐标)" as GFS #C8E6C9 {
    note right of GFS
      touchTrailPoints: List<OffsetF>
      pressedKeys: Set<InputKey>
      fingerIndicator: InputActionFingerIndicator?
    end note
  }

  rectangle "GestureFeedbackPanel\n(透明绘制层)" as GFP #C8E6C9 {
    note right of GFP
      反归一化: OffsetF * panelSize
      绘制轨迹/高亮/手指指示器
      Zone A / Zone B 多实例
    end note
  }

  rectangle "Compose UI\n面板组件" as UI #C8E6C9 {
    note right of UI
      KeyLayoutPanel (按键渲染)
      CandidateListPanel (候选栏)
      InputListPanel / ToolListPanel (输入栏/工具栏)
      PopupTipPanel (弹出提示)
    end note
  }

  rectangle "InputActionPlayer\n(程序化输入)" as IAP #C8E6C9 {
    note right of IAP
      播放 InputActionScript
      驱动 feedbackState
      驱动 handleIntent()
      管理 row1/row2 Indicator
    end note
  }
}

package "Domain Layer [:ime-engine]" #FFF3E0 {
  rectangle "ImeEngine\n(核心引擎)" as IE #FFE0B2 {
    note right of IE
      handleIntent()
      reduce(state, intent)
      状态机转换
      字典查询
      输出分发
    end note
  }

  rectangle "ImeIntent\n(用户意图)" as II #FFE0B2
  rectangle "ImeState\n(不可变状态)" as IS #FFE0B2 {
    note right of IS
      inputMode, isInputting
      keyboardState
      candidateList, inputList
      popupTip, toolList
      config
    end note
  }
  rectangle "ImeOutput\n(编辑输出)" as IO #FFE0B2
}

package "Platform Layer [:app]" #E3F2FD {
  rectangle "ImeOutputBridge\n(InputConnectionBridge)" as Bridge #BBDEFB
  rectangle "编辑器\n(InputConnection)" as Editor #BBDEFB
}

' ===== 用户手势输入流 =====
User -down-> GIP : 触摸事件
GIP -down-> GFS : 归一化坐标\n+ touchTrailPoints\n+ pressedKeys
GIP -down-> KVM : InputGesture
KVM -down-> II : ImeIntent\n(手势→意图转换)
II -down-> IE : handleIntent()
IE -down-> IS : reduce\nStateFlow 更新

' ===== 反馈流 =====
GFS -down-> GFP : collectAsState()\n反归一化绘制

' ===== 状态流 =====
IS -up-> UI : collectAsState()\n驱动面板重组
IS -up-> KVM : state 引用

' ===== 输出流 =====
IE -down-> IO : ImeOutput
IO -down-> Bridge : dispatchToTarget()
Bridge -down-> Editor : 语义方法调用

' ===== 程序化输入流 =====
IAP -left-> KVM : handleIntent(ImeIntent)
IAP -left-> GFS : setFingerIndicator()\nsetTouchTrailPoints()\nsetPressedKeys()

' ===== 分组标注 =====
rectangle "反馈流" #FFF9C4 {
}
rectangle "状态流" #E1F5FE {
}
rectangle "输出流" #F3E5F5 {
}
rectangle "程序化输入流" #FCE4EC {
}

@enduml
