@startuml mvi-data-flow
allowmixing
!theme plain
skinparam backgroundColor #FEFEFE
skinparam defaultFontSize 12
skinparam arrowThickness 1.5

title MVI Complete Data Flow

legend right
  |= Module/Category |= Color |= Description |
  | :app | <#E3F2FD> | Platform Layer |
  | :ui | <#E8F5E9> | UI + ViewModel Layer |
  | :engine | <#FFF3E0> | Domain + Data Layer |
  | Feedback Flow | <#FFF9C4> | GestureFeedbackState → GestureFeedbackPanel |
  | State Flow | <#E1F5FE> | ImeState → UI / ViewModel |
  | Output Flow | <#F3E5F5> | ImeEngine → EditorAction → Bridge → Editor |
  | Programmatic Input Flow | <#FCE4EC> | InputActionPlayer → KVM / GFS |
  | UI Components | <#C8E6C9> | :ui internal components |
  | Engine Components | <#FFE0B2> | :engine internal components |
  | Platform Components | <#BBDEFB> | :app internal components |
endlegend

' ===== User Gesture Input Flow (Main) =====

rectangle "User" as User #FFFFFF

package "UI Layer [:ui]" #E8F5E9 {
  rectangle "GestureInputPanel\n(Transparent Gesture Layer)" as GIP #C8E6C9
  rectangle "KeyboardViewModel\n(UI Coordination Center)" as KVM #C8E6C9
  rectangle "GestureFeedbackState\n(Normalized Coordinates)" as GFS #C8E6C9
  rectangle "GestureFeedbackPanel\n(Transparent Drawing Layer)" as GFP #C8E6C9
  rectangle "Compose UI\nPanel Components" as UI #C8E6C9
  rectangle "InputActionPlayer\n(Programmatic Input)" as IAP #C8E6C9
}

package "Domain Layer [:engine]" #FFF3E0 {
  rectangle "ImeEngine\n(Core Engine)" as IE #FFE0B2
  rectangle "ImeIntent\n(User Intent)" as II #FFE0B2
  rectangle "ImeState\n(Immutable State)" as IS #FFE0B2
  rectangle "ImeEffect\n(One-Time Effect)" as IEF #FFE0B2
  rectangle "EditorAction\n(Editor Operation)" as IO #FFE0B2
}

package "Platform Layer [:app]" #E3F2FD {
  rectangle "ImeEditorBridge\n(InputConnectionBridge)" as Bridge #BBDEFB
  rectangle "Editor\n(InputConnection)" as Editor #BBDEFB
}

' ===== User Gesture Input Flow =====
User -down-> GIP : touch events
GIP -down-> GFS : normalized coordinates\n+ touchTrailPoints\n+ pressedKeys
GIP -down-> KVM : InputGesture
KVM -down-> II : ImeIntent\n(gesture-to-intent conversion)
II -down-> IE : handleIntent()
IE -down-> IS : reduce\nStateFlow update
IE -down-> IEF : ImeEffect\nSharedFlow emit

' ===== Feedback Flow =====
GFS -[#FFF9C4]-> GFP : collectAsState()\ndenormalized drawing

' ===== State Flow =====
IS -[#E1F5FE]-> UI : collectAsState()\ndrives panel recomposition
IS -[#E1F5FE]-> KVM : state reference

' ===== Effect Flow =====
IEF -[#FCE4EC]-> KVM : collect\nPopupTip / PlayAudio

' ===== Output Flow =====
IE -[#F3E5F5]-> IO : EditorAction
IO -[#F3E5F5]-> Bridge : dispatchEditorAction()
Bridge -[#F3E5F5]-> Editor : semantic method calls

' ===== Programmatic Input Flow =====
IAP -[#FCE4EC]-> KVM : handleIntent(ImeIntent)
IAP -[#FCE4EC]-> GFS : setFingerIndicator()\nsetTouchTrailPoints()\nsetPressedKeys()

note right of GIP
  Receives touch events
  Writes normalized coords to GestureFeedbackState
  Queries KeyLayoutState.findKeyAt()
  Outputs InputGesture
end note

note right of KVM
  gestureToIntent() conversion
  handleGesture() / handleIntent()
  Manages KeyboardLayoutMode
  Manages GestureFeedbackState
  Maintains ToolListState (local)
  Subscribes ImeEffect → PopupTipState
  Integrates InputActionPlayer
end note

note right of GFS
  touchTrailPoints: List<OffsetF>
  pressedKeys: Set<InputKey>
  fingerIndicator: InputActionFingerIndicator?
end note

note right of GFP
  Denormalize: OffsetF * panelSize
  Draws trail / highlight / finger indicator
  Zone A / Zone B multi-instance
end note

note right of UI
  KeyLayoutPanel (key rendering)
  CandidateListPanel (candidate bar)
  InputListPanel / ToolListPanel (input/tool bar)
  PopupTipPanel (popup tips)
end note

note right of IAP
  Plays InputActionScript
  Drives feedbackState
  Drives handleIntent()
  Manages row1/row2 indicator
end note

note right of IE
  handleIntent()
  reduce(state, intent)
  State machine transitions
  Dict query
  Output dispatch
end note

note right of IS
  config.ui.keyboardInputMode
  keyboard.state
  candidateList, inputList
  config
end note

@enduml
