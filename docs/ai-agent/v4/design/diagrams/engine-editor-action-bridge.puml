@startuml engine-editor-action-bridge
!theme plain
skinparam backgroundColor #FEFEFE
skinparam classAttributeIconSize 0
skinparam defaultFontSize 11

title 编辑器操作与桥接模式

legend right
  |= 模块 |= 颜色 |= 说明 |
  | :ime-engine | <#FFF3E0> | 接口/抽象定义 |
  | :ime-ui | <#E8F5E9> | UI 层实现 |
  | :app | <#E3F2FD> | 应用层实现 |
  | 第三方 | <#F5F5F5> | 自定义实现 |
endlegend

' ===== EditorAction =====
package ":ime-engine" #FFF3E0 {

  class EditorAction <<(S,#FFF3E0)>> {
    + timestamp: Long
    --
    CommitText(text, replacements?)
    RevokeCommit
    InsertPairedSymbols(left, right)
    MoveCursor(direction)
    SelectRange(direction)
    PerformEdit(action)
  }

  class ImeEngine <<(C,#FFF3E0)>> {
    + handleIntent(intent)
    - dispatchEditorAction(action)
    - _editorBridges: MutableList<ImeEditorBridge>
    + attachEditorBridge(bridge)
    + detachEditorBridge(bridge)
  }

  interface ImeEditorBridge <<(I,#FFF3E0)>> {
    + commitText(text, replacements?)
    + revokeCommit()
    + insertPairedSymbols(left, right)
    + moveCursor(direction)
    + selectRange(direction)
    + performEdit(action)
    + getText(): CharSequence
    + getSelection(): TextRange
  }

  abstract class BaseImeEditorBridge <<(A,#FFF3E0)>> {
    - revertion: SelectionSnapshot?
    # resetRevertion()
    # recordRevertion(...)
    # onRevokeCommit(snapshot)
    # doNormalCommitText(text)
    # doReplaceableCommitText(text, replacements)
  }

  note right of BaseImeEditorBridge
    **撤销机制 (单快照)**
    - 仅支持撤销最近一次可撤回输入
    - 记录提交前后的选区快照
    - 新可撤回输入覆盖旧快照
    - revokeCommit() 消费后清空
  end note
}

' ===== :ime-ui 实现 =====
package ":ime-ui" #E8F5E9 {
  class EditTextBridge <<(C,#E8F5E9)>> {
    - targetSupplier: () -> EditText?
    + doNormalCommitText(text)
    + doReplaceableCommitText(text, replacements)
    + insertPairedSymbols(left, right)
    + moveCursor(direction)
    + selectRange(direction)
    + performEdit(action)
    + getText(): CharSequence
    + getSelection(): TextRange
    # onRevokeCommit(snapshot)
  }
  note right of EditTextBridge
    面向 EditText 目标
    直接操作 Editable 文本
    适用于非系统 IME 场景
  end note
}

' ===== :app 实现 =====
package ":app" #E3F2FD {
  class InputConnectionBridge <<(C,#E3F2FD)>> {
    - targetSupplier: () -> InputConnection?
    + doNormalCommitText(text)
    + doReplaceableCommitText(text, replacements)
    + insertPairedSymbols(left, right)
    + moveCursor(direction)
    + selectRange(direction)
    + performEdit(action)
    + getText(): CharSequence
    + getSelection(): TextRange
    # onRevokeCommit(snapshot)
  }
  note right of InputConnectionBridge
    面向系统 InputConnection
    由 IMEService 创建管理
    supplier 模式获取当前 IC
  end note
}

' ===== 第三方自定义 =====
package "第三方扩展" #F5F5F5 {
  class CustomBridge <<(C,#F5F5F5)>> {
    自定义实现
    (Web编辑器/游戏引擎/终端)
  }
  note right of CustomBridge
    简单场景: 直接实现 ImeEditorBridge
    需要撤销: 继承 BaseImeEditorBridge
  end note
}

' ===== 关系 =====
ImeEngine --> EditorAction : 生成
ImeEngine --> ImeEditorBridge : dispatchEditorAction()

ImeEditorBridge <|-- BaseImeEditorBridge : 抽象实现
BaseImeEditorBridge <|-- InputConnectionBridge : :app
BaseImeEditorBridge <|-- EditTextBridge : :ime-ui
ImeEditorBridge <|.. CustomBridge : 第三方

' ===== 分发流程 =====
note left of ImeEngine
  **dispatchEditorAction() 分发流程**
  when(action) {
    is CommitText -> bridge.commitText(text, replacements)
    is RevokeCommit -> bridge.revokeCommit()
    is InsertPairedSymbols -> bridge.insertPairedSymbols(left, right)
    is MoveCursor -> bridge.moveCursor(direction)
    is SelectRange -> bridge.selectRange(direction)
    is PerformEdit -> bridge.performEdit(action)
  }
end note

@enduml
