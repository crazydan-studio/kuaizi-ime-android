@startuml engine-overview
!theme plain
skinparam backgroundColor #FEFEFE
skinparam classAttributeIconSize 0
skinparam defaultFontSize 11

title :ime-engine 核心类关系

legend right
  |= 颜色 |= 说明 |
  | <#FFE0B2> | 核心模型 |
  | <#C8E6C9> | 状态类型 |
  | <#BBDEFB> | 内部组件 |
  | <#FFF3E0> | 输入动作 |
  | <#F3E5F5> | 日志系统 |
endlegend

' ===== 核心模型 (橙色) =====
package "核心模型" #FFE0B2 {
  class ImeEngine <<(C,#FFE0B2)>> {
    - state: MutableStateFlow<ImeState>
    + state: StateFlow<ImeState>
    - _outputBridge: ImeOutputBridge?
    + attachOutputBridge(bridge)
    + detachOutputBridge()
    + handleIntent(intent)
    + updateConfig(block)
    + {static} create(config, dictProvider): ImeEngine
  }
  class ImeConfig <<(D,#FFE0B2)>> {
    + engine: EngineConfig
    + ui: UiConfig
    + runtimeOverrides: Set<ConfigField>
  }
  class ImeIntent <<(S,#FFE0B2)>> {
    PressKey(key, gesture)
    SelectCandidate(candidate)
    SwitchKeyboard(type)
    CommitInput / DeleteInput
    SelectXPadPath(startZone, path)
    PerformEdit(action)
    UpdateConfig(config)
  }
  class ImeOutput <<(S,#FFE0B2)>> {
    CommitText(text, replacements?)
    RevokeCommit
    InsertPairedSymbols(left, right)
    MoveCursor(direction)
    SelectRange(direction)
    PerformEdit(action)
  }
  interface ImeOutputBridge <<(I,#FFE0B2)>> {
    commitText(text, replacements?)
    revokeCommit()
    insertPairedSymbols(left, right)
    moveCursor(direction)
    selectRange(direction)
    performAction(action)
    getText(): CharSequence
    getSelection(): TextRange
  }
  abstract class BaseImeOutputBridge <<(A,#FFE0B2)>> {
    # revertion: SelectionSnapshot?
    # resetRevertion()
    # recordRevertion(...)
    # onRevokeCommit(snapshot)
  }
}

' ===== 状态类型 (绿色) =====
package "状态类型" #C8E6C9 {
  class ImeState <<(D,#C8E6C9)>> {
    + keyboard: Keyboard
    + inputList: InputList
    + candidateList: CandidateList
    + config: ImeConfig
  }
  class Keyboard <<(D,#C8E6C9)>> {
    + type: KeyboardType
    + mode: KeyboardInputMode
    + state: KeyboardState
  }
  class InputList <<(D,#C8E6C9)>> {
    + inputs: List<InputItem>
    + gapIndex: Int
    + pendingSpell: String
  }
  class CandidateList <<(D,#C8E6C9)>> {
    + candidates: List<InputWord>
    + pageIndex: Int
    + pageSize: Int
    + hasMore: Boolean
  }
  class Clipboard <<(D,#C8E6C9)>> {
    + currentText: String?
    + showTip: Boolean
  }
  class FavoriteList <<(D,#C8E6C9)>> {
    + favorites: List<InputFavorite>
    + isLoading: Boolean
  }
}

' ===== 内部组件 (蓝色) =====
package "内部组件" #BBDEFB {
  class KeyboardStateMachine <<(C,#BBDEFB)>> {
    - _state: KeyboardState
    + state: KeyboardState
    + transition(t): List<ImeIntent>
    + backToPrevious()
  }
  class InputListOperator <<(C,#BBDEFB)>> {
    + apply(intent, list): InputList
  }
  class FeatureRegistry <<(C,#BBDEFB)>> {
    + isEnabled(feature): Boolean
  }
  class KeyAudioPlayer <<(C,#BBDEFB)>> {
    + play(keyType)
  }
  class CandidateListPager <<(C,#BBDEFB)>> {
    + page(direction)
  }
}

' ===== 输入动作 (浅橙) =====
package "输入动作" #FFF3E0 {
  class InputAction <<(S,#FFF3E0)>> {
    KeyDown / SwipeTo / KeyUp
    Wait / SelectCandidate / SwitchKeyboard
  }
  class InputActionScript <<(D,#FFF3E0)>> {
    + name / description / inputMethod
    + actions: List<InputAction>
    + totalDuration: Long
  }
  class InputActionScriptCompiler <<(C,#FFF3E0)>> {
    + compile(text, method, speed): InputActionScript
  }
  class InputActionFingerIndicator <<(D,#FFF3E0)>> {
    + position: OffsetF
    + pressed: Boolean
    + visible: Boolean
    + clickAnimation: ClickAnimation?
  }
  class ClickAnimation <<(D,#FFF3E0)>> {
    + progress: Float
    + maxRadius: Float
    + color: Long
  }
  class InputActionPathInterpolator <<(O,#FFF3E0)>> {
    + interpolate(from, to, ...): List<OffsetF>
  }
  interface InputActionPositionResolver <<(I,#FFF3E0)>> {
    + resolve(key): OffsetF?
    + resolveCandidatePosition(index): OffsetF?
    + resolveInputItemPosition(index): OffsetF?
  }
  class OffsetF <<(D,#FFF3E0)>> {
    + x: Float
    + y: Float
  }
  class RectF <<(D,#FFF3E0)>> {
    + left, top, right, bottom: Float
    + center: OffsetF
  }
}

' ===== 日志系统 (紫色) =====
package "日志系统" #F3E5F5 {
  class ImeLog <<(O,#F3E5F5)>> {
    + level: LogLevel
    + init(level, writers)
    + updateLevel(newLevel)
    + logger(tag): ImeLogger
  }
  class ImeLogger <<(C,#F3E5F5)>> {
    + verbose / debug / info / warn / error
    + tree(title, block)
  }
  class LogStorage <<(C,#F3E5F5)>> {
    + appendEntries(entries)
    + readLogs(...): List<LogEntry>
    + exportLogs(dest, from, to)
  }
}

' ===== 关系 =====
ImeEngine *-- KeyboardStateMachine : 组合
ImeEngine *-- InputListOperator : 组合
ImeEngine *-- FeatureRegistry : 组合
ImeEngine *-- KeyAudioPlayer : 组合
ImeEngine --> ImeIntent : 处理
ImeEngine --> ImeOutput : 生成
ImeEngine --> ImeOutputBridge : 分发
ImeEngine --> ImeState : 更新
ImeEngine --> ImeConfig : 持有

ImeOutputBridge <|-- BaseImeOutputBridge
KeyboardStateMachine --> KeyAudioPlayer : 使用
KeyboardStateMachine --> InputListOperator : 使用

ImeState *-- Keyboard
Keyboard *-- KeyboardType : type
Keyboard *-- KeyboardInputMode : mode
ImeState *-- InputList
ImeState *-- CandidateList
ImeState *-- Clipboard
ImeState *-- FavoriteList
ImeState *-- ImeConfig

InputActionScript *-- InputAction : actions
InputActionScriptCompiler ..> InputActionScript : 编译
InputActionFingerIndicator *-- ClickAnimation : clickAnimation
InputActionFingerIndicator *-- OffsetF : position
RectF --> OffsetF : center
InputActionPathInterpolator ..> OffsetF : 输入输出

@enduml
