@startuml ui-input-action-data-flow
!theme plain
skinparam backgroundColor #FEFEFE
skinparam defaultFontSize 11
skinparam arrowThickness 1.5

title 输入动作播放数据流

legend right
  |= 颜色 |= 说明 |
  ##FFF3E0 | :ime-engine 数据模型
  ##E8F5E9 | :ime-ui 实现
  ##E3F2FD | :app 集成
endlegend

' ===== 脚本加载 =====
rectangle "InputActionScriptLoader\n(:ime-ui)" as Loader #E8F5E9 {
  note left
    loadPreset(name)
    loadFromFile(uri)
    parseScript(json)
  end note
}
rectangle "InputActionScript\n(:ime-engine)\n坐标无关" as Script #FFF3E0 {
  note right
    name, description
    inputMethod: InputMethod
    actions: List<InputAction>
    totalDuration: Long
  end note
}

Loader -down-> Script : 加载/反序列化

' ===== 播放器 =====
rectangle "InputActionPlayer\n(:ime-ui)" as Player #E8F5E9 {
  note left
    load(script) → Ready
    play() → Playing
    按时间轴遍历 actions
    executeAction(action)
  end note
}

Script -down-> Player : load()

' ===== 坐标解析 =====
rectangle "ComposeInputActionPositionResolver\n(:ime-ui)" as Resolver #E8F5E9 {
  note left
    resolve(key) → KeyLayoutState.keyPositions
    resolveCandidatePosition(index) → locateItem + normalize
    resolveInputItemPosition(index) → locateItem + normalize
  end note
}
rectangle "KeyLayoutState\nCandidateListLayoutState\nInputListLayoutState\n(:ime-ui)" as LayoutState #E8F5E9

Resolver -up-> LayoutState : 惰性读取

' ===== 动作执行 =====
rectangle "executeAction\n(InputAction)" as Execute #FFF9C4 {
  note right
    KeyDown → resolve + setFingerIndicator + setPressedKeys
      + 启动 clickAnimation 涟漪
      + handleIntent(PressKey)
    SwipeTo → resolve(from/to) + interpolate
      + setTouchTrailPoints
      + animateFingerAlongPath
      + handleIntent(PressKey)
    KeyUp → setFingerIndicator(pressed=false) + clearPressedKeys
    SelectCandidate → resolveCandidatePosition
      + row1IndicatorState 更新
      + handleIntent(SelectCandidate)
    SwitchKeyboard → handleIntent(SwitchKeyboard)
  end note
}

Player -down-> Execute : 执行动作
Execute -left-> Resolver : 查询归一化坐标\nOffsetF

' ===== 路径插值 =====
rectangle "InputActionPathInterpolator\n(:ime-engine)" as Interpolator #FFF3E0 {
  note right
    interpolate(from, to, arcFactor, steps)
    → List<OffsetF>
    二次贝塞尔曲线
  end note
}

Execute -right-> Interpolator : SwipeTo\n生成插值路径

' ===== 反馈状态驱动 =====
rectangle "GestureFeedbackState\n(:ime-ui)\n归一化坐标" as Feedback #E8F5E9 {
  note right
    fingerIndicator: InputActionFingerIndicator
      position: OffsetF (归一化)
      pressed: Boolean
      clickAnimation: ClickAnimation?
    touchTrailPoints: List<OffsetF> (归一化)
    pressedKeys: Set<InputKey>
  end note
}

Execute -down-> Feedback : 写入归一化坐标

' ===== 行指示器 =====
rectangle "Row 1 行指示器\nrow1IndicatorState\nInputActionFingerIndicator\n(归一化坐标，行相对)" as Row1Ind #E8F5E9
rectangle "Row 2 行指示器\nrow2IndicatorState\nInputActionFingerIndicator\n(归一化坐标，行相对)" as Row2Ind #E8F5E9

Execute -down-> Row1Ind : SelectCandidate
Execute -down-> Row2Ind : (未来扩展)

' ===== 引擎状态转换 =====
rectangle "KeyboardViewModel\nhandleIntent(ImeIntent)" as KVM #E8F5E9
rectangle "ImeEngine\nreduce(state, intent)" as Engine #FFF3E0
rectangle "ImeState\nStateFlow" as State #FFF3E0

Execute -left-> KVM : handleIntent
KVM -down-> Engine : handleIntent
Engine -down-> State : StateFlow 更新

' ===== UI 渲染 =====
rectangle "GestureFeedbackPanel\n(:ime-ui)\nZone A / Zone B" as GFP #E8F5E9 {
  note right
    反归一化: OffsetF * panelSize
    绘制手指指示器
    绘制触摸轨迹
    绘制按键高亮
    绘制 clickAnimation 涟漪
  end note
}

rectangle "CandidateListPanel\n(:ime-ui)\nRow 1" as CLP #E8F5E9 {
  note right
    showIndicator=true (Animation)
    indicatorState → Row1Ind
    反归一化绘制圆形指示器
  end note
}

rectangle "InputListPanel / ToolListPanel\n(:ime-ui)\nRow 2" as Row2Panel #E8F5E9 {
  note right
    showIndicator=true (Animation)
    indicatorState → Row2Ind
    反归一化绘制圆形指示器
  end note
}

rectangle "KeyLayoutPanel\n(:ime-ui)" as KLP #E8F5E9 {
  note right
    按键状态渲染
    从 ImeState 读取
  end note
}

Feedback -down-> GFP : collectAsState()
Row1Ind -down-> CLP : indicatorState\n(Animation模式)
Row2Ind -down-> Row2Panel : indicatorState\n(Animation模式)
State -down-> KLP : collectAsState()
State -down-> CLP : candidateList
State -down-> Row2Panel : inputList / toolList

' ===== 内建指示器说明 =====
note across
  **内建指示器机制**:
  Row 1/2: 面板内建 Canvas 绘制
    (showIndicator + indicatorState 参数)
  Row 3: GestureFeedbackPanel 绘制
    (GestureFeedbackState.fingerIndicator)

  **ClickAnimation 涟漪**:
  仅在 Row 3 手指指示器下有语义
  GestureFeedbackPanel 在按键位置
  绘制涟漪扩散动画
end note

@enduml
