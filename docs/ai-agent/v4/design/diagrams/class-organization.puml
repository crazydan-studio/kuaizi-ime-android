}

' ==================== Key Relationships ====================

BaseImeEditorBridge <|-- InputConnectionBridge : :app
BaseImeEditorBridge <|-- EditTextBridge : :ui
InputActionPositionResolver <|.. ComposeInputActionPositionResolver : :ui

ImeEngine *-- KeyboardStateMachine
ImeEngine *-- InputListOperator
ImeState *-- Keyboard : keyboard
Keyboard *-- KeyboardType : type
Keyboard *-- KeyboardHandMode : handMode
ImeConfig *-- RuntimeConfig : runtime
ImeSqliteDictProvider *-- DictRepository
ImeSqliteDictProvider *-- PinyinCharsTree
ImeSqliteDictProvider *-- HmmModel
DictRepository --> ViterbiDecoder

KeyboardViewModel *-- GestureFeedbackState
KeyboardViewModel *-- InputActionPlayer
KeyTableGenerator <|.. PinyinKeyTable : :ui
KeyTableGenerator <|.. SymbolEmojiKeyTable : :ui
KeyTableContext *-- Keyboard : keyboard
KeyTableContext *-- InputList : inputList
KeyTableContext *-- CandidateList : candidateList
InputActionPlayer *-- InputActionPlayerState
InputActionPlayer --> ComposeInputActionPositionResolver
InputActionPlayer --> GestureFeedbackState
InputActionScriptLoader --> InputActionScript

ImeLog *-- LogWriter
LogWriter <|.. FileLogWriter
LogWriter <|.. LogcatWriter
FileLogWriter --> LogStorage
CrashInterceptor --> LogStorage
CrashInterceptor --> LogWriter

InputActionFingerIndicator *-- ClickAnimation : clickAnimation
InputActionScript *-- InputAction : actions
InputActionScriptCompiler ..> InputActionScript : compiles
InputActionPathInterpolator ..> OffsetF : io

IMEService --> KeyboardViewModel : Factory(engine)
IMEService --> InputConnectionBridge : create & attach
ConfigDataStore --> ImeConfig : persist
ExerciseScreen --> InputActionPlayerPanel : uses
InputActionPlayerPanel --> KeyboardInputActionPlayerHost : composition

@enduml
