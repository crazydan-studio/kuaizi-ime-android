@startuml class-organization
!theme plain
skinparam backgroundColor #FEFEFE
skinparam classAttributeIconSize 0
skinparam defaultFontSize 11

title Class Organization Overview

legend right
  |= Module |= Color |= Description |
  | :app | <#E3F2FD> | Platform Layer |
  | :ui | <#E8F5E9> | UI + ViewModel Layer |
  | :engine | <#FFF3E0> | Domain + Data Layer |
endlegend

' ==================== :engine module ====================

package ":engine" #FFF3E0 {

  package "engine.core" {
    class ImeEngine <<(O,#FFF3E0)>> {
      + state: StateFlow<ImeState>
      + handleIntent(intent: ImeIntent)
      + updateConfig(block)
      + attachEditorBridge(bridge)
      + detachEditorBridge(bridge)
      + create(config, dictProvider): ImeEngine
    }
    class ImeConfig <<(D,#FFF3E0)>> {
      + engine: EngineConfig
      + ui: UiConfig
      + runtime: RuntimeConfig
    }
    class RuntimeConfig <<(D,#FFF3E0)>> {
      + screenOrientation: ScreenOrientation
      + editorInputType: EditorInputType
      + keyPopupTipsEnabled: Boolean?
      + toolSettingsEnabled: Boolean
      + toolSwitchIMEEnabled: Boolean
      + toolCloseKeyboardEnabled: Boolean
    }
    class StartupConfig <<(D,#FFF3E0)>> {
      + imeSubtype: IMESubtype
      + screenOrientation: ScreenOrientation
      + editorInputType: EditorInputType?
    }
    class ImeIntent <<(S,#FFF3E0)>> {
      {static} PressKey(key, gesture)
      {static} SelectCandidate(candidate)
      {static} SwitchKeyboard(type)
      {static} CommitInput
      {static} DeleteInput
      {static} PerformEdit(action)
      {static} UpdateConfig(config)
    }
    class EditorAction <<(S,#FFF3E0)>> {
      {static} CommitText(text, replacements)
      {static} RevokeCommit
      {static} InsertPairedSymbols(left, right)
      {static} MoveCursor(direction)
      {static} PerformEdit(action)
    }
    class ImeState <<(D,#FFF3E0)>> {
      + keyboard: Keyboard
      + inputList: InputList
      + candidateList: CandidateList
      + config: ImeConfig
    }
    class Keyboard <<(D,#FFF3E0)>> {
      + type: KeyboardType
      + handMode: KeyboardHandMode?
      + state: KeyboardState
    }
  }

  package "engine.output" {
    interface ImeEditorBridge <<(I,#FFF3E0)>> {
      + commitText(text, replacements?)
      + revokeCommit()
      + insertPairedSymbols(left, right)
      + moveCursor(direction)
      + selectRange(direction)
      + performEdit(action)
      + getText(): CharSequence
      + getSelection(): TextRange
    }
    abstract class BaseImeEditorBridge <<(A,#FFF3E0)>> {
      # revertion: SelectionSnapshot?
      # resetRevertion()
      # recordRevertion(...)
      # onRevokeCommit(snapshot)
      # doNormalCommitText(text)
      # doReplaceableCommitText(text, replacements)
    }
  }

  package "engine.state" {
    class KeyboardType <<(E,#FFF3E0)>> {
      Pinyin
      Latin
      Number
      Symbol
      Emoji
      Math
      Editor
      Candidate
      CommitOption
    }
    class KeyboardInputMode <<(E,#FFF3E0)>> {
      HexGrid
      RectGrid
    }
    class KeyboardState <<(S,#FFF3E0)>> {
      {static} Idle
      {static} PinyinInput.Waiting
      {static} PinyinInput.Slipping
      {static} PinyinInput.Flipping
      {static} CandidateSelection.Choosing
      {static} CandidateSelection.Filtering
      {static} CandidateSelection.AdvanceFiltering
      {static} CommitOptionChoosing
      {static} EditorEditing.CursorMoving
      {static} EditorEditing.TextSelecting
      {static} SymbolChoosing
      {static} EmojiChoosing
    }
    class InputList <<(D,#FFF3E0)>> {
      + inputs: List<InputItem>
      + gapIndex: Int
      + pendingSpell: String
    }
    class CandidateList <<(D,#FFF3E0)>> {
      + candidates: List<InputWord>
      + pageIndex: Int
      + pageSize: Int
      + hasMore: Boolean
    }
  }

  package "engine.input_action" {
    class InputAction <<(S,#FFF3E0)>> {
      {static} KeyDown(startTime, key)
      {static} SwipeTo(startTime, fromKey, toKey, duration)
      {static} KeyUp(startTime, key)
      {static} Wait(startTime, duration)
      {static} SelectCandidate(startTime, candidateIndex)
      {static} SwitchKeyboard(startTime, targetType)
    }
    class InputActionScript <<(D,#FFF3E0)>> {
      + name: String
      + description: String
      + inputActionMode: InputActionMode
      + actions: List<InputAction>
      + totalDuration: Long
    }
    class InputActionScriptCompiler <<(C,#FFF3E0)>> {
      + compile(text, method, speed): InputActionScript
      - compileTapActions(...)
      - compileSwipeActions(...)
    }
    class InputActionFingerIndicator <<(D,#FFF3E0)>> {
      + position: OffsetF
      + pressed: Boolean
      + visible: Boolean
      + clickAnimation: ClickAnimation?
    }
    class ClickAnimation <<(D,#FFF3E0)>> {
      + progress: Float
      + maxRadius: Float
      + color: Long
    }
    class InputActionPathInterpolator <<(O,#FFF3E0)>> {
      + interpolate(from, to, arcFactor, steps): List<OffsetF>
    }
    interface InputActionPositionResolver <<(I,#FFF3E0)>> {
      + resolve(key): OffsetF?
      + resolveCandidatePosition(index): OffsetF?
      + resolveInputItemPosition(index): OffsetF?
    }
    class OffsetF <<(D,#FFF3E0)>> {
      + x: Float
      + y: Float
    }
    class RectF <<(D,#FFF3E0)>> {
      + left: Float
      + top: Float
      + right: Float
      + bottom: Float
      + center: OffsetF
    }
  }

  package "engine.internal" {
    class KeyboardStateMachine <<(C,#FFF3E0)>> {
      + state: KeyboardState
      + transition(t): List<ImeIntent>
      + backToPrevious()
    }
    class InputListOperator <<(C,#FFF3E0)>> {
      + apply(intent, list): InputList
    }
  }

  package "engine.dict" {
    interface ImeDictProvider <<(I,#FFF3E0)>> {
      + query(pinyin): List<Candidate>
      + queryPrefix(prefix): List<Candidate>
      + recordInput(pinyin, word)
    }
    class ImeSqliteDictProvider <<(C,#FFF3E0)>> {
      + query(pinyin): List<Candidate>
      + queryPrefix(prefix): List<Candidate>
      + recordInput(pinyin, word)
    }
    class DictRepository <<(C,#FFF3E0)>> {
      + lookupPinyinWords(spell): List<InputWord>
      + lookupPinyinPhrases(spells): List<InputWord>
      + predictPhrase(spell, context): List<InputWord>
      + recordUserInput(text, type)
      + observeFavorites(): Flow<List<InputFavorite>>
    }
    class PinyinCharsTree <<(D,#FFF3E0)>> {
      + children: Map<Char, PinyinCharsTree>
      + keys: List<InputKey.Char>
      + find(prefix): PinyinCharsTree?
    }
    class HmmModel <<(D,#FFF3E0)>> {
      + states: Set<HmmState>
      + transitionProb: Map<HmmState, Map<HmmState, Double>>
      + emissionProb: Map<HmmState, Map<HmmObservation, Double>>
    }
    class ViterbiDecoder <<(C,#FFF3E0)>> {
      + decode(observations): List<HmmState>
    }
  }

  package "engine.logging" {
    class ImeLog <<(O,#FFF3E0)>> {
      + level: LogLevel
      + init(level, writers)
      + updateLevel(newLevel)
      + logger(tag): ImeLogger
    }
    class ImeLogger <<(C,#FFF3E0)>> {
      + verbose(msg)
      + debug(msg)
      + info(msg)
      + warn(msg)
      + error(msg)
      + tree(title, block)
    }
    class LogLevel <<(E,#FFF3E0)>> {
      VERBOSE
      DEBUG
      INFO
      WARN
      ERROR
    }
    class LogEntry <<(D,#FFF3E0)>> {
      + level: LogLevel
      + tag: String
      + message: String
      + throwable: Throwable?
      + timestamp: Long
      + format(): String
    }
    interface LogWriter <<(I,#FFF3E0)>> {
      + write(entry)
      + flush()
    }
    class FileLogWriter <<(C,#FFF3E0)>> {
      + write(entry)
      + flush()
    }
    class LogcatWriter <<(C,#FFF3E0)>> {
      + write(entry)
      + flush()
    }
    class CrashInterceptor <<(C,#FFF3E0)>> {
      + install()
    }
    class LogStorage <<(C,#FFF3E0)>> {
      + appendEntries(entries)
      + readLogs(date?, levelFilter?, keyword?): List<LogEntry>
      + exportLogs(destination, fromDate, toDate)
      + updateDir(logDir)
    }
  }
}

' ==================== :ui module ====================

package ":ui" #E8F5E9 {

  package "ui.viewmodel" {
    class KeyboardViewModel <<(C,#E8F5E9)>> {
      + state: StateFlow<ImeState>
      + config: ImeConfig
      + layoutMode: StateFlow<KeyboardLayoutMode>
      + feedbackState: GestureFeedbackState
      + actionPlayer: InputActionPlayer
      + handleGesture(gesture)
      + handleIntent(intent)
      + setKeyboardLayoutMode(mode)
      + updateConfig(transform)
      + updateKeyLayoutState(state)
      + updateCandidateLayoutState(state)
      + updateInputListLayoutState(state)
    }
    class GestureFeedbackState <<(C,#E8F5E9)>> {
      + touchTrailPoints: StateFlow<List<OffsetF>>
      + pressedKeys: StateFlow<Set<InputKey>>
      + fingerIndicator: StateFlow<InputActionFingerIndicator?>
      + addTouchTrailPoint(point)
      + setTouchTrailPoints(points)
      + setPressedKeys(keys)
      + setFingerIndicator(state?)
      + clearAll()
      + clear()
    }
  }

  package "ui.integration" {
    class KeyboardHost <<(C,#E8F5E9)>> {
      + (Composable) KeyboardHost(viewModel)
    }
    class KeyboardInputActionPlayerHost <<(C,#E8F5E9)>> {
      + UseMode.Animation
      + UseMode.DirectInput
      + (Composable) KeyboardInputActionPlayerHost(viewModel, useMode)
    }
    class InputActionPlayerPanel <<(C,#E8F5E9)>> {
      + Input exercise playback control panel
    }
  }

  package "ui.panel" {
    class GestureInputPanel <<(C,#E8F5E9)>> {
      + Transparent gesture interception layer
      + Receives touch events
      + Outputs InputGesture
    }
    class KeyLayoutPanel <<(C,#E8F5E9)>> {
      + Key layout rendering layer
      + onLayoutStateChanged callback
      + Renders based on KeyboardInputMode + Type
    }
    class GestureFeedbackPanel <<(C,#E8F5E9)>> {
      + Transparent feedback drawing layer
      + Normalized coordinate drawing
      + Supports multi-instance
    }
    class CandidateListPanel <<(C,#E8F5E9)>> {
      + Candidate bar (built-in IndicatorOverlay)
      + showIndicator: Boolean
      + indicatorState: InputActionFingerIndicator?
    }
    class InputListPanel <<(C,#E8F5E9)>> {
      + Input bar (built-in IndicatorOverlay)
      + showIndicator: Boolean
      + indicatorState: InputActionFingerIndicator?
    }
    class ToolListPanel <<(C,#E8F5E9)>> {
      + Tool list panel (built-in IndicatorOverlay)
      + showIndicator: Boolean
      + indicatorState: InputActionFingerIndicator?
    }
    class PopupTipPanel <<(C,#E8F5E9)>> {
      + Popup tip panel
      + Reads state from ImeState
    }
  }

  package "ui.player" {
    class InputActionPlayerState <<(S,#E8F5E9)>> {
      {static} Idle
      {static} Ready(script)
      {static} Playing(currentIndex, totalActions)
      {static} Paused(currentIndex, totalActions)
      {static} Finished
    }
    class InputActionPlayer <<(C,#E8F5E9)>> {
      + playbackState: StateFlow<InputActionPlayerState>
      + row1IndicatorState: StateFlow<InputActionFingerIndicator?>
      + row2IndicatorState: StateFlow<InputActionFingerIndicator?>
      + load(script)
      + play()
      + pause()
      + resume()
      + stop()
      + setSpeed(speed)
    }
    class ComposeInputActionPositionResolver <<(C,#E8F5E9)>> {
      + resolve(key): OffsetF?
      + resolveCandidatePosition(index): OffsetF?
      + resolveInputItemPosition(index): OffsetF?
    }
    class InputActionScriptLoader <<(C,#E8F5E9)>> {
      + loadPreset(name): InputActionScript
      + listPresets(): List<String>
      + loadFromFile(uri): InputActionScript
    }
  }

  package "ui.theme" {
    class KeyboardColors <<(D,#E8F5E9)>> {
      + keyBackground/Foreground/Pressed/...
      + candidatePanelBackground/...
      + inputListPanelBackground/...
    }
    class KeyboardThemes <<(O,#E8F5E9)>> {
      + Light: KeyboardColors
      + Night: KeyboardColors
    }
    class LocalKeyboardColors <<(O,#E8F5E9)>> {
      CompositionLocal providing colors
    }
  }

  package "ui.util" {
    class CoordinateNormalizer <<(O,#E8F5E9)>> {
      + normalize(offset, sourceSize): OffsetF
      + denormalize(normalized, targetSize): Offset
    }
  }

  package "ui.keyboard" {
    class KeyTableGenerator <<(I,#E8F5E9)>> {
      + generate(context): List<List<InputKey>>
    }
    class KeyTableContext <<(D,#E8F5E9)>> {
      + config: ImeConfig
      + keyboard: Keyboard
      + inputList: InputList
      + candidateList: CandidateList
    }
    class KeyLayoutState <<(D,#E8F5E9)>> {
      + keyPositions: Map<InputKey, RectF>
      + panelSize: Size
      + findKeyAt(position, targetSize): InputKey?
      + denormalize(normalized, targetSize): Rect
    }
    class CandidateListLayoutState <<(D,#E8F5E9)>> {
      + candidatePositions: List<Rect>
      + panelSize: Size
      + locateItem(index): Offset?
    }
    class InputListLayoutState <<(D,#E8F5E9)>> {
      + itemPositions: List<Rect>
      + panelSize: Size
      + locateItem(index): Offset?
    }
  }
}

