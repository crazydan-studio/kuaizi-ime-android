@startuml ui-keyboard-panel
!theme plain
skinparam backgroundColor #FEFEFE
skinparam defaultFontSize 12

title KeyboardHost 组合布局

legend right
  |= 颜色 |= 说明 |
  ##C8E6C9 | GestureInputPanel
  ##FFF9C4 | GestureFeedbackPanel
  ##BBDEFB | KeyLayoutPanel
  ##FFCDD2 | 候选/输入/工具面板
  ##E1BEE7 | 指示器
endlegend

' ===== Stacked 模式 =====
rectangle "Stacked 模式 (堆叠)" as Stacked #FFFFFF {
  rectangle "Zone B (100%)" as SB_ZoneB #F5F5F5 {

    rectangle "Row 1" as SB_R1 #FFCDD2 {
      rectangle "CandidateListPanel\n(showIndicator, indicatorState)" as SB_CLP #FFCDD2
      rectangle "PopupTipPanel\n(叠加，短暂浮现)" as SB_PTP #E1BEE7
    }

    rectangle "Row 2" as SB_R2 #FFCDD2 {
      rectangle "ToolListPanel\n(空闲时，showIndicator, indicatorState)" as SB_TLP #FFCDD2
      rectangle "InputListPanel\n(输入时互斥，showIndicator, indicatorState)" as SB_ILP #FFCDD2
    }

    rectangle "Row 3\n三层面板叠加" as SB_R3 #FFFFFF {
      rectangle "KeyLayoutPanel\n(最下层，渲染)" as SB_KLP #BBDEFB
      rectangle "GestureFeedbackPanel\n(中间层，反馈)" as SB_GFP #FFF9C4
      rectangle "GestureInputPanel\n(最上层，触摸)" as SB_GIP #C8E6C9
    }
  }
  note right of SB_ZoneB
    Zone A 不使用 (高度=0)
    KeyLayoutPanel 部署在 Zone B Row 3
    GestureFeedbackPanel 单实例
  end note
}

' ===== Separated 模式 =====
rectangle "Separated 模式 (分离)" as Separated #FFFFFF {
  rectangle "Zone A (40%)" as SP_ZoneA #F5F5F5 {
    rectangle "KeyLayoutPanel\n(底层渲染，单实例)" as SP_KLP #BBDEFB
    rectangle "GestureFeedbackPanel\n(Zone A 实例)" as SP_GFP_A #FFF9C4
  }
  note right of SP_ZoneA
    KeyLayoutPanel 部署在 Zone A
    GestureFeedbackPanel Zone A 实例
  end note

  rectangle "Zone B (60%)" as SP_ZoneB #F5F5F5 {

    rectangle "Row 1" as SP_R1 #FFCDD2 {
      rectangle "CandidateListPanel\n(showIndicator, indicatorState)" as SP_CLP #FFCDD2
      rectangle "PopupTipPanel\n(叠加)" as SP_PTP #E1BEE7
    }

    rectangle "Row 2" as SP_R2 #FFCDD2 {
      rectangle "ToolListPanel\n(空闲时，showIndicator, indicatorState)" as SP_TLP #FFCDD2
      rectangle "InputListPanel\n(输入时互斥，showIndicator, indicatorState)" as SP_ILP #FFCDD2
    }

    rectangle "Row 3 (三列布局)" as SP_R3 #FFFFFF {

      rectangle "左列\n功能按钮\n(切换等)" as SP_Left #E0E0E0

      rectangle "中列\n手势交互区" as SP_Mid #FFFFFF {
        rectangle "GestureFeedbackPanel\n(Zone B 实例)" as SP_GFP_B #FFF9C4
        rectangle "GestureInputPanel\n(叠加)" as SP_GIP #C8E6C9
      }

      rectangle "右列\n功能按钮\n(删除等)" as SP_Right #E0E0E0

    }
  }
  note right of SP_ZoneB
    GestureFeedbackPanel Zone B 实例
    Row 3 不含 KeyLayoutPanel
    (已部署在 Zone A)
  end note
}

' ===== KeyboardInputActionPlayerHost =====
rectangle "KeyboardInputActionPlayerHost" as KIAPH #E8F5E9 {
  rectangle "Animation 模式" as Anim #E8F5E9 {
    note right
      showIndicator = true
      传递 row1Indicator → CandidateListPanel
      传递 row2Indicator → InputListPanel/ToolListPanel
      Row 3: FingerIndicator via GestureFeedbackPanel
    end note
  }
  rectangle "DirectInput 模式" as Direct #E8F5E9 {
    note right
      showIndicator = false
      不显示 Row 1/2 指示器
      仅 Row 3: FingerIndicator via GestureFeedbackPanel
    end note
  }
}

' ===== 实例策略表 =====
note bottom
  **实例策略表**
  | 组件 | Stacked | Separated |
  |------|---------|-----------|
  | KeyLayoutPanel | Zone B Row 3 (单实例) | Zone A (单实例) |
  | GestureFeedbackPanel | Zone B Row 3 (单实例) | Zone A + Zone B (双实例) |
  | GestureInputPanel | Zone B Row 3 | Zone B Row 3 中列 |
  | CandidateListPanel | Zone B Row 1 | Zone B Row 1 |
  | InputListPanel / ToolListPanel | Zone B Row 2 | Zone B Row 2 |
  | PopupTipPanel | Zone B Row 1 叠加 | Zone B Row 1 叠加 |
end note

@enduml
