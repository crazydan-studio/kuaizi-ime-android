@startuml architecture
!theme plain
skinparam backgroundColor #FEFEFE
skinparam componentStyle rectangle
skinparam defaultFontSize 12
skinparam packageStyle rectangle

title 三层库架构总览

' 颜色定义
skinparam component<<app>> #E3F2FD
skinparam component<<ime_ui>> #E8F5E9
skinparam component<<ime_engine>> #FFF3E0

legend right
  |= 模块 |= 颜色 |= 说明 |
  | :app | <#E3F2FD> | Platform Layer - 平台集成 |
  | :ime-ui | <#E8F5E9> | UI Layer + ViewModel Layer |
  | :ime-engine | <#FFF3E0> | Domain Layer + Data Layer |
endlegend

package ":app 模块\n(Platform Layer)" as app #E3F2FD {
  component [IMEService\n(薄壳)] as IMEService <<app>>
  component [InputConnectionBridge] as ICB <<app>>
  component [ConfigDataStore] as CDS <<app>>
  component [LogExportScreen\nLogViewerScreen\nLogLevelSetting] as AppLogUI <<app>>
  component [SettingsScreen\nMainScreen\nExerciseScreen\nInputActionPlayerPanel] as AppScreens <<app>>
}

package ":ime-ui 模块\n(UI Layer + ViewModel Layer)" as ui #E8F5E9 {
  package "ViewModel Layer" {
    component [KeyboardViewModel] as KVM <<ime_ui>>
    component [GestureFeedbackState] as GFS <<ime_ui>>
  }
  package "UI Layer - 集成组件" {
    component [KeyboardHost] as KH <<ime_ui>>
    component [KeyboardInputActionPlayerHost] as KIAPH <<ime_ui>>
  }
  package "UI Layer - 面板组件" {
    component [GestureInputPanel] as GIP <<ime_ui>>
    component [KeyLayoutPanel] as KLP <<ime_ui>>
    component [GestureFeedbackPanel] as GFP <<ime_ui>>
    component [CandidateListPanel] as CLP <<ime_ui>>
    component [InputListPanel] as ILP <<ime_ui>>
    component [ToolListPanel] as TLP <<ime_ui>>
    component [PopupTipPanel] as PTP <<ime_ui>>
  }
  package "UI Layer - 主题与工具" {
    component [KeyboardTheme\nKeyboardColors\nLocalKeyboardColors] as Theme <<ime_ui>>
    component [CoordinateNormalizer] as CN <<ime_ui>>
    component [ComposeInputActionPositionResolver] as CIAPR <<ime_ui>>
    component [InputActionPlayer] as IAP <<ime_ui>>
    component [InputActionScriptLoader] as IASL <<ime_ui>>
    component [InputActionPlayerState] as IAPS <<ime_ui>>
    component [EditTextBridge] as EB <<ime_ui>>
  }
}

package ":ime-engine 模块\n(Domain Layer + Data Layer)" as engine #FFF3E0 {
  package "Domain Layer - 核心模型" {
    component [ImeEngine] as IE <<ime_engine>>
    component [ImeConfig] as IC <<ime_engine>>
    component [ImeIntent] as II <<ime_engine>>
    component [ImeOutput] as IO <<ime_engine>>
    component [ImeOutputBridge\nBaseImeOutputBridge] as IOB <<ime_engine>>
    component [ImeState\n+ 子状态] as IS <<ime_engine>>
  }
  package "Domain Layer - 输入动作" {
    component [InputAction\n(Sealed Class)] as IA <<ime_engine>>
    component [InputActionScript] as IAS <<ime_engine>>
    component [InputActionScriptCompiler] as IASC <<ime_engine>>
    component [InputActionFingerIndicator] as IAFI <<ime_engine>>
    component [ClickAnimation] as CA <<ime_engine>>
    component [InputActionPathInterpolator] as IAPI <<ime_engine>>
    component [InputActionPositionResolver\n(Interface)] as IAPR <<ime_engine>>
    component [OffsetF / RectF] as OFRF <<ime_engine>>
  }
  package "Domain Layer - 内部组件" {
    component [KeyboardStateMachine] as KSM <<ime_engine>>
    component [InputListOperator] as ILO <<ime_engine>>
    component [FeatureRegistry] as FR <<ime_engine>>
  }
  package "Domain Layer - 日志" {
    component [ImeLog / ImeLogger] as IL <<ime_engine>>
    component [LogLevel / LogEntry] as LLE <<ime_engine>>
    component [LogWriter\nFileLogWriter\nLogcatWriter\nCrashInterceptor] as LW <<ime_engine>>
    component [LogStorage] as LS <<ime_engine>>
  }
  package "Data Layer" {
    component [ImeDictProvider\n(Interface)] as IDP <<ime_engine>>
    component [ImeSqliteDictProvider] as ISDP <<ime_engine>>
    component [DictRepository] as DR <<ime_engine>>
    component [PinyinCharsTree] as PCT <<ime_engine>>
    component [HmmModel\nViterbiDecoder] as HMM <<ime_engine>>
  }
}

' :app → :ime-ui 依赖
IMEService --> KVM : Factory(engine)
IMEService --> ICB : 创建并挂载
ICB -up-|> IOB : 实现
AppScreens --> KH : 使用
AppLogUI --> LS : 读取/导出

' :ime-ui → :ime-engine 依赖
KVM --> IE : 持有引用\nhandleIntent()
KVM --> IS : collectAsState()
KVM --> IC : config
KVM --> GFS : 管理
IAP --> IAPR : 坐标解析
IAP --> IAPS : 播放状态
IAP --> IAFI : 手指指示器
IAP --> IAPI : 路径插值
IAP --> CA : 点击涟漪
CIAPR -up-|> IAPR : 实现
KH --> GIP : 叠加
KH --> KLP : 叠加
KH --> GFP : 叠加
KH --> CLP : 布局
KH --> ILP : 布局
KH --> TLP : 布局
EB -up-|> IOB : 实现
Theme --> IC : 读取 UiConfig

' :ime-engine 内部
IE *-- KSM : 组合
IE *-- ILO : 组合
IE *-- FR : 组合
IE --> II : 处理
IE --> IO : 生成
IE --> IOB : 分发
IE --> IDP : 字典查询
ISDP *-- DR : 委托
ISDP *-- PCT : 组合
ISDP *-- HMM : 组合
IASC --> IAS : 编译生成
IAS *-- IA : 包含
IAFI *-- CA : 包含\n(clickAnimation)
IAFI *-- OFRF : 使用
IAPI --> OFRF : 输入输出
IL --> LW : 分发
LW --> LS : 写入

@enduml
