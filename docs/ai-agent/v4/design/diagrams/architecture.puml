@startuml architecture
!theme plain
skinparam backgroundColor #FEFEFE
skinparam componentStyle rectangle
skinparam defaultFontSize 12
skinparam packageStyle rectangle

title Three-Layer Architecture Overview

legend right
  |= Module |= Color |= Description |
  | :app | <#E3F2FD> | Platform Layer |
  | :ui | <#E8F5E9> | UI Layer + ViewModel Layer |
  | :engine | <#FFF3E0> | Domain Layer + Data Layer |
  | :app-codegen | <#FCE4EC> | KSP Code Generation |
endlegend

package ":app (Platform Layer)" as app #E3F2FD {
  component [IMEService\n(Thin Shell)] as IMEService <<app>>
  component [InputConnectionBridge] as ICB <<app>>
  component [ConfigDataStore] as CDS <<app>>
  component [LogExportScreen\nLogViewerScreen\nLogLevelSetting] as AppLogUI <<app>>
  component [SettingsScreen\nMainScreen\nExerciseScreen] as AppScreens <<app>>
}

package ":ui (UI Layer + ViewModel Layer)" as ui #E8F5E9 {
  package "ViewModel Layer" {
    component [KeyboardViewModel] as KVM <<ui>>
    component [GestureFeedbackState] as GFS <<ui>>
  }
  package "UI Layer - Integration" {
    component [KeyboardHost] as KH <<ui>>
    component [KeyboardInputActionPlayerHost] as KIAPH <<ui>>
    component [InputActionPlayerPanel] as IAPP <<ui>>
  }
  package "UI Layer - Panels" {
    component [GestureInputPanel] as GIP <<ui>>
    component [KeyLayoutPanel] as KLP <<ui>>
    component [GestureFeedbackPanel] as GFP <<ui>>
    component [CandidateListPanel] as CLP <<ui>>
    component [InputListPanel] as ILP <<ui>>
    component [ToolListPanel] as TLP <<ui>>
    component [PopupTipPanel] as PTP <<ui>>
  }
  package "UI Layer - Theme & Tools" {
    component [KeyboardTheme\nKeyboardColors\nLocalKeyboardColors] as Theme <<ui>>
    component [CoordinateNormalizer] as CN <<ui>>
    component [ComposeInputActionPositionResolver] as CIAPR <<ui>>
    component [InputActionPlayer] as IAP <<ui>>
    component [InputActionScriptLoader] as IASL <<ui>>
    component [InputActionPlayerState] as IAPS <<ui>>
    component [EditTextBridge] as EB <<ui>>
  }
}

package ":engine (Domain Layer + Data Layer)" as engine #FFF3E0 {
  package "Domain Layer - Core Models" {
    component [ImeEngine] as IE <<engine>>
    component [ImeConfig\n(+ RuntimeConfig)] as IC <<engine>>
    component [ImeIntent] as II <<engine>>
    component [EditorAction] as IO <<engine>>
    component [ImeEditorBridge\nBaseImeEditorBridge] as IOB <<engine>>
    component [ImeState\n+ Substates] as IS <<engine>>
    component [Keyboard\n(type, handMode, state)] as K <<engine>>
    component [KeyboardType\n(enum)] as KT <<engine>>
    component [KeyboardInputMode\n(enum)] as KIM <<engine>>
  }
  package "Domain Layer - Input Action" {
    component [InputAction\n(Sealed Class)] as IA <<engine>>
    component [InputActionScript] as IAS <<engine>>
    component [InputActionScriptCompiler] as IASC <<engine>>
    component [InputActionFingerIndicator] as IAFI <<engine>>
    component [ClickAnimation] as CA <<engine>>
    component [InputActionPathInterpolator] as IAPI <<engine>>
    component [InputActionPositionResolver\n(Interface)] as IAPR <<engine>>
    component [OffsetF / RectF] as OFRF <<engine>>
  }
  package "Domain Layer - Internal" {
    component [KeyboardStateMachine] as KSM <<engine>>
    component [InputListOperator] as ILO <<engine>>
  }
  package "Domain Layer - Logging" {
    component [ImeLog / ImeLogger] as IL <<engine>>
    component [LogLevel / LogEntry] as LLE <<engine>>
    component [LogWriter\nFileLogWriter\nLogcatWriter\nCrashInterceptor] as LW <<engine>>
    component [LogStorage] as LS <<engine>>
  }
  package "Data Layer" {
    component [ImeDictProvider\n(Interface)] as IDP <<engine>>
    component [ImeSqliteDictProvider] as ISDP <<engine>>
    component [DictRepository] as DR <<engine>>
    component [PinyinCharsTree] as PCT <<engine>>
    component [HmmModel\nViterbiDecoder] as HMM <<engine>>
  }
}

': app -> ui dependencies
IMEService --> KVM : Factory(engine)
IMEService --> ICB : create & attach
ICB -up-|> IOB : implements
AppScreens --> KH : uses
AppScreens --> IAPP : uses
AppLogUI --> LS : read/export

': ui -> engine dependencies
KVM --> IE : holds reference\nhandleIntent()
KVM --> IS : collectAsState()
KVM --> IC : config
KVM --> GFS : manages
IAP --> IAPR : coordinate resolution
IAP --> IAPS : playback state
IAP --> IAFI : finger indicator
IAP --> IAPI : path interpolation
IAP --> CA : click ripple
CIAPR -up-|> IAPR : implements
KH --> GIP : overlays
KH --> KLP : overlays
KH --> GFP : overlays
KH --> CLP : layout
KH --> ILP : layout
KH --> TLP : layout
IAPP --> KIAPH : composition
EB -up-|> IOB : implements
Theme --> IC : reads UiConfig

': engine internal
IE *-- KSM : composition
IE *-- ILO : composition
IE --> II : processes
IE --> IO : generates
IE --> IOB : dispatches
IE --> IDP : dict query
ISDP *-- DR : delegates
ISDP *-- PCT : composition
ISDP *-- HMM : composition
IS *-- K : keyboard
K *-- KT : type
IASC --> IAS : compiles
IAS *-- IA : contains
IAFI *-- CA : contains\n(clickAnimation)
IAFI *-- OFRF : uses
IAPI --> OFRF : io
IL --> LW : dispatches
LW --> LS : writes

package ":app-codegen (KSP Code Generation)" as codegen #FCE4EC {
  component [ConfigDataStoreKeys\nCode Generator] as CDK <<codegen>>
}

CDS --> CDK : uses generated code

@enduml
