@startuml engine-logging
!theme plain
skinparam backgroundColor #FEFEFE
skinparam classAttributeIconSize 0
skinparam defaultFontSize 11

title 日志系统 [:ime-engine]

legend right
  |= 颜色 |= 说明 |
  | <#FFE0B2> | 门面与记录器 |
  | <#C8E6C9> | 数据模型 |
  | <#BBDEFB> | Writer 接口与实现 |
  | <#F3E5F5> | 工具类 |
endlegend

' ===== 门面与记录器 =====
package "门面与记录器" #FFE0B2 {
  class ImeLog <<(O,#FFE0B2)>> {
    - writers: MutableList<LogWriter>
    + level: LogLevel
    + init(level, writers)
    + updateLevel(newLevel)
    + logger(tag): ImeLogger
    + logger(cls): ImeLogger
    - dispatch(entry)
    - flush()
  }
  note right of ImeLog
    平台无关的日志门面
    单例 object
    应用层注入 level 和 writers
  end note

  class ImeLogger <<(C,#FFE0B2)>> {
    - tag: String
    - log: ImeLog
    + verbose(msg: () -> String)
    + debug(msg: () -> String)
    + info(msg: () -> String)
    + warn(msg: () -> String)
    + error(msg: () -> String)
    + error(throwable, msg)
    + tree(title, block)
  }
  note right of ImeLogger
    inline + lambda 延迟求值
    等级不满足时 lambda 不执行
    tree() 支持树形日志块
  end note
}

' ===== 数据模型 =====
package "数据模型" #C8E6C9 {
  class LogLevel <<(E,#C8E6C9)>> {
    VERBOSE (2)
    DEBUG (3)
    INFO (4)
    WARN (5)
    ERROR (6)
    + fromPriority(priority): LogLevel
  }
  class LogEntry <<(D,#C8E6C9)>> {
    + level: LogLevel
    + tag: String
    + message: String
    + throwable: Throwable?
    + timestamp: Long
    + threadName: String
    + threadId: Long
    + format(): String
  }
  note right of LogEntry
    不可变日志条目
    format() 用于文件输出
    格式: yyyy-MM-dd HH:mm:ss.SSS [LEVEL] [TAG] [Thread] msg
  end note

  class LogBlock <<(D,#C8E6C9)>> {
    + title: String
    + children: List<LogEntry>
    + nested: List<LogBlock>
  }
}

' ===== Writer 接口与实现 =====
package "Writer 接口与实现" #BBDEFB {
  interface LogWriter <<(I,#BBDEFB)>> {
    + write(entry: LogEntry)
    + flush()
  }

  class FileLogWriter <<(C,#BBDEFB)>> {
    - channel: Channel<LogEntry>
    - scope: CoroutineScope
    - storage: LogStorage
    + write(entry)
    + flush()
  }
  note right of FileLogWriter
    Channel 缓冲 + 独立协程批量写入
    最多 100 条/批
    不阻塞调用线程
  end note

  class LogcatWriter <<(C,#BBDEFB)>> {
    + write(entry)
    + flush()
  }
  note right of LogcatWriter
    映射到 android.util.Log
    位于 androidMain 源集
    flush() 空实现 (即时输出)
  end note

  class LogStorage <<(C,#BBDEFB)>> {
    - logDir: File
    + appendEntries(entries)
    + readLogs(date?, levelFilter?, keyword?): List<LogEntry>
    + exportLogs(destination, fromDate, toDate)
    + updateDir(logDir)
  }
  note right of LogStorage
    纯 Kotlin 实现
    不依赖 Android Context
    每天一个文件
    保留 7 天，单文件最大 5MB
    文件命名: kuaizi_ime_YYYY-MM-DD.log
  end note
}

' ===== 工具类 =====
package "工具类" #F3E5F5 {
  class CrashInterceptor <<(C,#F3E5F5)>> {
    - defaultHandler: UncaughtExceptionHandler?
    - writers: List<LogWriter>
    - storage: LogStorage
    + install()
    - handleCrash(thread, throwable)
  }
  note right of CrashInterceptor
    JVM 标准 UncaughtExceptionHandler
    位于 commonMain 源集
    崩溃时:
    1. 直接写入 LogStorage (绕过 Channel)
    2. 同步 flush 所有 Writer
    3. 委托原始 Handler
  end note
}

' ===== 关系 =====
ImeLog *-- LogWriter : 注册
ImeLog --> ImeLogger : 创建
ImeLog --> LogEntry : dispatch
ImeLogger --> ImeLog : dispatch
ImeLogger --> LogBlock : tree()

LogWriter <|.. FileLogWriter : 引擎内置
LogWriter <|.. LogcatWriter : 引擎提供

FileLogWriter --> LogStorage : 写入
CrashInterceptor --> LogStorage : 直接写入
CrashInterceptor --> LogWriter : flush

LogEntry --> LogLevel : level
LogEntry *-- LogLevel : 包含

' ===== 初始化流程 =====
note bottom of ImeLog
  **应用层初始化示例**
  val level = if (BuildConfig.DEBUG) VERBOSE else config.ui.logLevel
  val writers = buildList {
    if (BuildConfig.DEBUG) add(LogcatWriter())
    add(FileLogWriter(LogStorage(resolveLogDir())))
  }
  ImeLog.init(level, writers)
  CrashInterceptor(writers, storage).install()
end note

@enduml
