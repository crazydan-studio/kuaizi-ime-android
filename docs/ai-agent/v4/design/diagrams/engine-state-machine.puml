@startuml engine-state-machine
!theme plain
skinparam backgroundColor #FEFEFE
skinparam defaultFontSize 11

title 键盘状态机

legend right
  |= 颜色 |= 说明 |
  | <#FFE0B2> | 顶层状态 |
  | <#C8E6C9> | 拼音输入子状态 |
  | <#BBDEFB> | 候选选择子状态 |
  | <#F3E5F5> | 编辑器子状态 |
  | <#FFCDD2> | 符号/Emoji 子状态 |
endlegend

' ===== 顶层状态 =====
state "Idle\n空闲" as Idle #FFE0B2

' ===== 拼音输入 =====
state "PinyinInput" as PinyinInput #C8E6C9 {
  state "Waiting\n等待输入\npending: CharInput?" as Waiting #C8E6C9
  state "Slipping\n滑行输入中\nstartKey, levels, nextChars" as Slipping #C8E6C9
  state "Flipping\n翻转输入中\nstartChar, candidates" as Flipping #C8E6C9
  state "XPadding\nX-Pad 输入中\nzones, currentSpell" as XPadding #C8E6C9
}

' ===== 候选选择 =====
state "CandidateSelection" as CandidateSelection #BBDEFB {
  state "Choosing\n候选选择\ncandidates, pageIndex" as Choosing #BBDEFB
  state "Filtering\n候选过滤\nspell, filtered" as Filtering #BBDEFB
  state "AdvanceFiltering\n高级过滤\nradical?, tone?, filtered" as AdvanceFiltering #BBDEFB
}

' ===== 提交选项 =====
state "CommitOptionChoosing\n提交选项\noptions: List<CommitOption>" as CommitOption #FFE0B2

' ===== 编辑器 =====
state "EditorEditing" as EditorEditing #F3E5F5 {
  state "CursorMoving\n光标移动\nposition: Int" as CursorMoving #F3E5F5
  state "TextSelecting\n文本选择\nstart, end" as TextSelecting #F3E5F5
}

' ===== 符号/Emoji =====
state "SymbolChoosing\n符号选择\ngroupId?" as Symbol #FFCDD2
state "EmojiChoosing\nEmoji 选择\ngroupId?" as Emoji #FFCDD2

' ===== 转换关系 =====

Idle --> Waiting : InputPinyinChar\n键盘切换到拼音
Idle --> Symbol : OpenSymbolGroup
Idle --> Emoji : OpenEmojiGroup
Idle --> CursorMoving : 编辑器操作

Waiting --> Slipping : BeginSlip(startKey)
Waiting --> Flipping : BeginFlip(startChar)
Waiting --> XPadding : BeginXPad(zones)
Waiting --> Choosing : LoadCandidates

Slipping --> Waiting : SelectSlipChar
Slipping --> Choosing : LoadCandidates

Flipping --> Waiting : SelectFlipChar
Flipping --> Choosing : LoadCandidates

XPadding --> Waiting : SelectXPadZone
XPadding --> Choosing : LoadCandidates

Choosing --> Filtering : FilterCandidates(spell)
Choosing --> AdvanceFiltering : AdvanceFilterCandidates
Choosing --> Waiting : ReturnToIdle\n(选择候选后)
Choosing --> CommitOption : LoadCommitOptions

Filtering --> Choosing : BackToPrevious
AdvanceFiltering --> Choosing : BackToPrevious

CommitOption --> Waiting : ReturnToIdle

CursorMoving --> TextSelecting : SelectText
TextSelecting --> Idle : ReturnToIdle

Symbol --> Idle : ReturnToIdle
Emoji --> Idle : ReturnToIdle

' ===== 键盘类型初始状态 =====
note right of Idle
  **键盘类型初始状态**
  Pinyin → Waiting
  Latin → Waiting
  Number → Idle
  Math → Idle
  Symbol → SymbolChoosing
  Emoji → EmojiChoosing
  Candidate → Choosing
  CommitOption → CommitOptionChoosing
end note

' ===== StateHistory =====
note left of Idle
  **StateHistory 有界历史栈**
  maxSize = 10
  键盘切换时清空
  同一键盘内子状态回退通过 pop()
  撤销不依赖状态历史
  (依赖 InputList 撤销栈)
end note

@enduml
